{
  "name": "discord-failure-notifier",
  "version": "1.0.0",
  "description": "Send a Discord webhook message when a workflow job fails",
  "keywords": [],
  "license": "MIT",
  "author": "Jaded-Encoding-Thaumaturgy",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=dist/index.js",
    "check": "npm run format-check && npm run lint && npm run typecheck",
    "lint": "oxlint src",
    "format": "oxfmt --write \"**/*.{ts,json,yml}\"",
    "format-check": "oxfmt --check \"**/*.{ts,json,yml}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
